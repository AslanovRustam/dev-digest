{
  "name": "@devdigest/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DevDigest MCP server — local stdio server exposing review tools over the DevDigest HTTP API.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "devdigest-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "start": "node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^17.4.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
